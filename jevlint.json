{
  "fix": {
    "command": ["agent", "acp"]
  },
  "languages": {
    "c": {},
    "cpp": {},
    "csharp": {},
    "go": {},
    "java": {},
    "javascript": {},
    "kotlin": {},
    "php": {},
    "python": {},
    "ruby": {},
    "rust": {},
    "tsx": {},
    "typescript": {}
  },
  "rules": [
    {
      "id": "database-joins",
      "description": "Fail only when the code clearly retrieves related records from the same database and joins, matches, merges, or enriches them in application code instead of in the query. If database-backed records cannot be established from the supplied code, pass. AST processing, parsing, and general in-memory collection operations pass.",
      "severity": "error",
      "kinds": ["function"],
      "include": ["**/*"],
      "exclude": [
        "**/examples/**",
        "**/test/**",
        "**/tests/**",
        "**/testdata/**",
        "**/__tests__/**",
        "**/*_test.go",
        "**/*.test.js",
        "**/*.test.jsx",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.js",
        "**/*.spec.jsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/test_*.py",
        "**/*_test.py"
      ],
      "exceptions": [
        "The data comes from different services or databases.",
        "The join cannot reasonably be expressed by the database or ORM."
      ],
      "localize": ["statement"]
    },
    {
      "id": "boolean-property-naming",
      "description": "Boolean property and field names should make the true state clear while following the language's conventions. Predicate prefixes such as Is, Has, Can, or Should and positive state names such as Enabled, Ready, or Visible pass. Concise domain names also pass when the containing type makes their meaning unambiguous, such as color on outputStyle. Fail vague names such as Flag, Value, or Data, misleading names, and negative names that create double negatives. Do not require an Is or Should prefix.",
      "severity": "error",
      "kinds": ["field"],
      "include": ["**/*"],
      "exclude": [
        "**/examples/**",
        "**/test/**",
        "**/tests/**",
        "**/testdata/**",
        "**/__tests__/**",
        "**/*_test.go",
        "**/*.test.js",
        "**/*.test.jsx",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.js",
        "**/*.spec.jsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/test_*.py",
        "**/*_test.py"
      ],
      "localize": []
    },
    {
      "id": "comment-quality",
      "description": "Comments should be helpful and concise without focusing too much on what the code is doing.",
      "severity": "warning",
      "kinds": ["comment"],
      "include": ["**/*"],
      "exclude": [
        "**/examples/**",
        "**/test/**",
        "**/tests/**",
        "**/testdata/**",
        "**/__tests__/**",
        "**/*_test.go",
        "**/*.test.js",
        "**/*.test.jsx",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.js",
        "**/*.spec.jsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/test_*.py",
        "**/*_test.py"
      ],
      "localize": []
    },
    {
      "id": "redundant-if-statements",
      "description": "If statements must not be redundant",
      "severity": "warning",
      "kinds": ["function"],
      "include": ["**/*"],
      "exclude": [
        "**/examples/**",
        "**/test/**",
        "**/tests/**",
        "**/testdata/**",
        "**/__tests__/**",
        "**/*_test.go",
        "**/*.test.js",
        "**/*.test.jsx",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.js",
        "**/*.spec.jsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/test_*.py",
        "**/*_test.py"
      ],
      "localize": []
    },
    {
      "id": "function-control-flow",
      "description": "Functions should have one clear control-flow responsibility. Fail functions with three or more nested decisions or loops, or with several unrelated branching phases that should be named helpers. Guard clauses, straightforward retry loops, and focused worker-pool coordination pass.",
      "severity": "warning",
      "kinds": ["function"],
      "include": ["**/*"],
      "exclude": [
        "**/examples/**",
        "**/test/**",
        "**/tests/**",
        "**/testdata/**",
        "**/__tests__/**",
        "**/*_test.go",
        "**/*.test.js",
        "**/*.test.jsx",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.js",
        "**/*.spec.jsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/test_*.py",
        "**/*_test.py"
      ],
      "localize": []
    },
    {
      "id": "redundant-type-properties",
      "description": "Types should not have redundant properties where data can be inferred from other properties.",
      "severity": "warning",
      "kinds": ["type"],
      "include": ["**/*"],
      "exclude": [
        "**/examples/**",
        "**/test/**",
        "**/tests/**",
        "**/testdata/**",
        "**/__tests__/**",
        "**/*_test.go",
        "**/*.test.js",
        "**/*.test.jsx",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.js",
        "**/*.spec.jsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/test_*.py",
        "**/*_test.py"
      ],
      "localize": ["field"]
    }
  ]
}
